* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.tex text
*.bib text
*.pdf binary
*.zip binary

# Frozen inputs and research evidence are identified by byte-level SHA-256.
# Preserve their original line endings on every platform and checkout.
/runs/** -text
/analyses/** -text
/src/** -text
/tools/** -text
/manuscript/** -text
